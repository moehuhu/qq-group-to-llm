{
  "compilerOptions": {
    "rootDir": ".",
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["esnext", "dom"],
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strictBindCallApply": true,
    "types": ["node"]
  },
  "include": ["client", "src"]
}
